<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="15dp">

    <ImageView
        android:id="@+id/goupIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_multi_people"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/groupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Photography Trip"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toEndOf="@id/goupIcon"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/groupDebt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You owe PKR6,423.00"
        android:textColor="@android:color/holo_orange_light"
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toEndOf="@id/goupIcon"
        app:layout_constraintTop_toBottomOf="@id/groupTitle" />


</androidx.constraintlayout.widget.ConstraintLayout>
